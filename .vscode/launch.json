{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "All",
            "configurations": [
                "Frontend",
                "Frontend.Api",
                "Checkins",
                "Checkins.Api",
                "Comments",
                "Comments.Api",
                "Ratings",
                "Ratings.Api"
            ]
        },
        {
            "name": "Backend",
            "configurations": [
                "Frontend.Api",
                "Checkins",
                "Checkins.Api",
                "Comments",
                "Comments.Api",
                "Ratings",
                "Ratings.Api"
            ]
        }
    ],
    "configurations": [
        {
            "name": "Run AppHost",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}\\application\\apphost\\src\\Lab.RateMyBeer.AppHost\\Lab.RateMyBeer.AppHost.csproj"
        },
        {
            "name": "Checkins",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "buildCheckins",
            "program": "${workspaceFolder}/application/checkins/src/Lab.RateMyBeer.Checkins/bin/Debug/net6.0/Lab.RateMyBeer.Checkins.dll",
            "args": [],
            "cwd": "${workspaceFolder}/application/checkins/src/Lab.RateMyBeer.Checkins",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "DOTNET_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
